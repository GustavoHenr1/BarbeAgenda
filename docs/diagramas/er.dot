digraph ER {
  rankdir=LR; nodesep=0.5; ranksep=1.3; bgcolor=white; splines=polyline;
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555", arrowhead=crow, arrowtail=teetee, dir=both, penwidth=1.2];
  cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white">
   <tr><td colspan="3" bgcolor="#A8641C"><font color="white"><b>cliente</b></font></td></tr>
   <tr><td align="left">PK</td><td align="left"><b>id_cliente</b></td><td align="left">INT (PK, AI)</td></tr>
   <tr><td></td><td align="left">nome</td><td align="left">VARCHAR(100) NN</td></tr>
   <tr><td></td><td align="left">telefone</td><td align="left">VARCHAR(20) NN, UQ</td></tr>
   <tr><td></td><td align="left">email</td><td align="left">VARCHAR(120) NN</td></tr>
   <tr><td></td><td align="left">data_cadastro</td><td align="left">DATETIME NN</td></tr></table>>];
  profissional [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white">
   <tr><td colspan="3" bgcolor="#A8641C"><font color="white"><b>profissional</b></font></td></tr>
   <tr><td>PK</td><td align="left"><b>id_profissional</b></td><td align="left">INT (PK, AI)</td></tr>
   <tr><td></td><td align="left">nome</td><td align="left">VARCHAR(100) NN</td></tr>
   <tr><td></td><td align="left">telefone</td><td align="left">VARCHAR(20)</td></tr>
   <tr><td></td><td align="left">email</td><td align="left">VARCHAR(120) NN</td></tr>
   <tr><td></td><td align="left">especialidade</td><td align="left">VARCHAR(100)</td></tr>
   <tr><td></td><td align="left">ativo</td><td align="left">TINYINT(1) NN</td></tr></table>>];
  servico [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white">
   <tr><td colspan="3" bgcolor="#A8641C"><font color="white"><b>servico</b></font></td></tr>
   <tr><td>PK</td><td align="left"><b>id_servico</b></td><td align="left">INT (PK, AI)</td></tr>
   <tr><td></td><td align="left">nome</td><td align="left">VARCHAR(80) NN, UQ</td></tr>
   <tr><td></td><td align="left">descricao</td><td align="left">VARCHAR(255)</td></tr>
   <tr><td></td><td align="left">preco</td><td align="left">DECIMAL(8,2) NN</td></tr>
   <tr><td></td><td align="left">duracao_min</td><td align="left">INT NN</td></tr></table>>];
  usuario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white">
   <tr><td colspan="3" bgcolor="#A8641C"><font color="white"><b>usuario</b></font></td></tr>
   <tr><td>PK</td><td align="left"><b>id_usuario</b></td><td align="left">INT (PK, AI)</td></tr>
   <tr><td></td><td align="left">nome</td><td align="left">VARCHAR(100) NN</td></tr>
   <tr><td></td><td align="left">login</td><td align="left">VARCHAR(50) NN, UQ</td></tr>
   <tr><td></td><td align="left">senha_hash</td><td align="left">VARCHAR(255) NN</td></tr>
   <tr><td></td><td align="left">perfil</td><td align="left">ENUM NN</td></tr>
   <tr><td></td><td align="left">criado_em</td><td align="left">DATETIME NN</td></tr></table>>];
  agendamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="white">
   <tr><td colspan="3" bgcolor="#1F1C19"><font color="white"><b>agendamento</b></font></td></tr>
   <tr><td>PK</td><td align="left"><b>id_agendamento</b></td><td align="left">INT (PK, AI)</td></tr>
   <tr><td>FK</td><td align="left">id_cliente</td><td align="left">INT NN</td></tr>
   <tr><td>FK</td><td align="left">id_profissional</td><td align="left">INT NN</td></tr>
   <tr><td>FK</td><td align="left">id_servico</td><td align="left">INT NN</td></tr>
   <tr><td>FK</td><td align="left">id_usuario</td><td align="left">INT NN</td></tr>
   <tr><td></td><td align="left">data_hora</td><td align="left">DATETIME NN</td></tr>
   <tr><td></td><td align="left">status</td><td align="left">ENUM NN</td></tr>
   <tr><td></td><td align="left">observacao</td><td align="left">VARCHAR(255)</td></tr>
   <tr><td></td><td align="left">criado_em</td><td align="left">DATETIME NN</td></tr></table>>];
  cliente -> agendamento [label="1 : N"]; profissional -> agendamento [label="1 : N"];
  servico -> agendamento [label="1 : N"]; usuario -> agendamento [label="1 : N"];
}
